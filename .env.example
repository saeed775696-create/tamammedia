# ============================================================
#  متغيرات البيئة المطلوبة لمشروع تمام ميديا
#  انسخ هذا الملف إلى .env (للإنتاج) أو .env.local (محليًا)
# ============================================================

# ---------- قاعدة البيانات (Supabase PostgreSQL) ----------
# Pooler URL — للاستخدام في التطبيق (مع PgBouncer)
# صيغة Supabase: postgresql://postgres.[project-ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct URL — للأوامر الإدارية (migrations, db push)
# صيغة Supabase: postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------- المصادقة (NextAuth) ----------
# مطلوب إجباريًا؛ يُولّد عبر: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# رابط الموقع الكامل (بدون شرطة مائلة في النهاية)
# للإنتاج: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ---------- Supabase Storage (لرفع الصور) ----------
# نجدها في: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ---------- Google Analytics (اختياري) ----------
# اتركه فارغًا إن لم يكن مطلوبًا
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
