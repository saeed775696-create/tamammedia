generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ... باقي النماذج (كما هي) ...

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  language  String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioItem {
  id            String   @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String   // الصورة الرئيسية
  gallery       String?  // صور إضافية بصيغة JSON array: ["url1","url2"]
  category      String   // "website", "ecommerce", "branding", "video", "social", "web"
  clientName    String?
  completionDate String? // مثال: "2025-12"
  technologies  String?  // JSON array: ["Next.js","Tailwind"]
  link          String?  // رابط المشروع الحي
  videoUrl      String?  // رابط فيديو يوتيوب
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model Service {
  id            String   @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  iconName      String?
  imageUrl      String?   // أضف هذا السطر
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  timestamp DateTime @default(now())
  language  String?
}

model WhatsAppClick {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String
  role     String  @default("admin")
}