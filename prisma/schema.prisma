generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // DIRECT_URL ضروري لـ Supabase connection pooler (PgBouncer)
  // يُستخدم للأوامر الإدارية مثل migrations و db push
  directUrl = env("DIRECT_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  language  String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PortfolioItem {
  id             String   @id @default(cuid())
  titleEn        String
  titleAr        String
  descriptionEn  String?
  descriptionAr  String?
  imageUrl       String
  // JSON type مدعوم في PostgreSQL — أفضل من String
  gallery        Json?
  category       String
  clientName     String?
  completionDate String?
  technologies   Json?
  link           String?
  videoUrl       String?
  featured       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([order])
}

model Service {
  id            String   @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  iconName      String?
  imageUrl      String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  timestamp DateTime @default(now())
  language  String?

  @@index([path])
  @@index([timestamp])
}

model WhatsAppClick {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  password              String
  role                  String    @default("admin")
  isActive              Boolean   @default(true)
  mustChangePassword    Boolean   @default(false)
  sessionVersion        Int       @default(0)
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([role, isActive])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([expiresAt])
}

// Shared fixed-window counters. The application hashes every logical key before
// storing it, so IP addresses and email addresses never appear in this table.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model EmailChangeCode {
  id           String   @id @default(cuid())
  userId       String
  currentEmail String
  newEmail     String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([newEmail, createdAt])
  @@index([expiresAt])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  website   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// This table already exists in production and stores key/value configuration.
// Global content is stored under the `site-content` key as a JSON document.
model SiteSetting {
  id        String   @id
  key       String   @unique
  value     String?
  category  String   @default("general")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}
